---
import Layout from '../layouts/Layout.astro';
import { BRAND_NAME } from '../site';
---

<Layout
  title={`Contact | ${BRAND_NAME}`}
  description={`How to contact ${BRAND_NAME} with questions, bug reports or corrections.`}
  robots="noindex"
>
  <main class="mx-auto max-w-3xl px-4 py-10 sm:px-8">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">Contact</h1>
    <p class="mt-4 text-lg text-slate-600">
      You can reach us at patraritabrata6@gmail.com.
    </p>
    <p class="mt-4 text-slate-600">
      Write to us about questions, problems with the tool, a preset size that looks out of date, or privacy questions.
    </p>
    <p class="mt-4 text-slate-600">
      We read every message but cannot promise a reply time. Please do not email photos, signatures or identity documents.
    </p>
  </main>
</Layout>
