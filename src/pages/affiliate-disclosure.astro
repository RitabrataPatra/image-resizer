---
import Layout from '../layouts/Layout.astro';
import { BRAND_NAME } from '../site';
---

<Layout
  title={`Affiliate Disclosure | ${BRAND_NAME}`}
  description={`How ${BRAND_NAME} may earn money from links and advertising.`}
>
  <main class="mx-auto max-w-3xl px-4 py-10 sm:px-8">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">Affiliate Disclosure</h1>
    <p class="mt-4 text-lg text-slate-600">
      This site currently contains no affiliate links or advertisements.
    </p>
    <p class="mt-4 text-slate-600">
      In the future, some links may be affiliate links, which means we may earn a commission if you buy something through them, at no extra cost to you. Any such link will be clearly marked, and this page will be updated before they appear.
    </p>
  </main>
</Layout>
