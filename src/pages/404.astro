---
import Layout from '../layouts/Layout.astro';
import { BRAND_NAME } from '../site';
---

<Layout
  title={`Page not found | ${BRAND_NAME}`}
  description="The page you requested could not be found."
  robots="noindex"
>
  <main class="mx-auto max-w-3xl px-4 py-16 sm:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">
      Page not found
    </h1>
    <p class="mt-3 text-slate-700">
      Sorry, we couldn’t find the page you’re looking for.
    </p>
    <nav class="mt-6 flex flex-wrap gap-4 text-sm font-medium">
      <a
        href="/"
        class="text-slate-900 underline decoration-slate-300 underline-offset-4 hover:decoration-slate-900"
      >
        Return to home
      </a>
      <a
        href="/all-sizes/"
        class="text-slate-900 underline decoration-slate-300 underline-offset-4 hover:decoration-slate-900"
      >
        Browse all sizes
      </a>
    </nav>
  </main>
</Layout>
