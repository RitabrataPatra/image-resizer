---
import Layout from '../layouts/Layout.astro';
import Resizer from '../App';
import { BRAND_NAME, SITE_URL, TOOL_NAME } from '../site';

const homepageTitle = `Free Image Resizer – Resize JPG, PNG & Images Online | ${BRAND_NAME}`;
const homepageDescription =
  'Resize JPG and PNG images online for free. Set custom dimensions or KB file-size limits, then process images privately in your browser without uploading them.';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: BRAND_NAME,
      url: `${SITE_URL}/`,
      description: homepageDescription,
    },
    {
      '@type': 'WebApplication',
      '@id': `${SITE_URL}/#webapp`,
      name: TOOL_NAME,
      url: `${SITE_URL}/`,
      applicationCategory: 'ImageEditingApplication',
      operatingSystem: 'Web Browser',
      description: homepageDescription,
      isPartOf: {
        '@id': `${SITE_URL}/#website`,
      },
    },
  ],
};
---

<Layout
  title={homepageTitle}
  description={homepageDescription}
  structuredData={structuredData}
>
  <main class="mx-auto max-w-6xl px-4 py-6 sm:px-8 sm:py-8">
    <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7">
      <h1 class="max-w-3xl text-3xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        Resize Any Image to Any Size or KB
      </h1>
      <p class="mt-3 max-w-2xl text-base text-slate-600 sm:text-lg">
        Free, private resizing in your browser for IDs, forms, uploads, and official documents.
      </p>
    </section>

    <Resizer client:load />

    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Resize images for forms and uploads</h2>
      <p class="mt-3 max-w-3xl text-slate-700">
        {BRAND_NAME} helps you crop an image and meet a required file-size or print-dimension target before uploading it to an application, ID form, or website. It is useful whenever an online form has strict image requirements and you need a quick JPG export.
      </p>
      <p class="mt-3 text-slate-700">
        <a href="/all-sizes/" class="font-medium text-slate-900 underline decoration-slate-300 underline-offset-4 hover:text-slate-700">Browse all photo and signature presets</a>
        or read our <a href="/guides/reduce-image-file-size/" class="font-medium text-slate-900 underline decoration-slate-300 underline-offset-4 hover:text-slate-700">guide to reducing image file size for uploads</a>.
      </p>
    </section>

    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Frequently asked questions</h2>
      <div class="mt-5 space-y-5">
        <div class="border-b border-slate-100 pb-4">
          <h3 class="text-lg font-semibold text-slate-900">What file size limits can I set?</h3>
          <p class="mt-2 text-slate-700">Set a minimum and maximum output size in KB to match the upload requirement. You can also choose a preset or enter your own target range.</p>
        </div>
        <div class="border-b border-slate-100 pb-4">
          <h3 class="text-lg font-semibold text-slate-900">Which image formats are supported?</h3>
          <p class="mt-2 text-slate-700">You can upload JPG or PNG images. The resized image is exported as a JPG.</p>
        </div>
        <div class="border-b border-slate-100 pb-4">
          <h3 class="text-lg font-semibold text-slate-900">Are my images private?</h3>
          <p class="mt-2 text-slate-700">Yes. Images are processed in your browser and are not uploaded to a server.</p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-slate-900">Can I use the tool on my phone?</h3>
          <p class="mt-2 text-slate-700">Yes. The tool works in a mobile browser, and you can choose an image from your phone or take a photo where your browser allows it.</p>
        </div>
      </div>
    </section>

    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">How it works</h2>
      <ol class="mt-5 grid gap-4 text-slate-700 sm:grid-cols-3">
        <li class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <span class="mb-2 block text-sm font-semibold uppercase tracking-[0.16em] text-red-600">01</span>
          Upload your image.
        </li>
        <li class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <span class="mb-2 block text-sm font-semibold uppercase tracking-[0.16em] text-red-600">02</span>
          Crop, scale, and set the target size.
        </li>
        <li class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <span class="mb-2 block text-sm font-semibold uppercase tracking-[0.16em] text-red-600">03</span>
          Review and download the JPG, then verify its file size and dimensions against the destination’s requirements.
        </li>
      </ol>
    </section>

    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
      <p class="text-sm text-slate-700">
        Privacy note: images are processed locally in your browser and never leave your device.
      </p>
    </section>
  </main>
</Layout>
